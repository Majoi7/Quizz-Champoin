# ============================================================================
# SUPABASE (Base de données PostgreSQL + Realtime)
# ============================================================================
# Frontend & Realtime (clés publiques Supabase)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Backend Express / Vercel Serverless (la clé service_role reste strictement côté serveur)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# ============================================================================
# CLOUD SQL POSTGRESQL (Optionnel - utilisé si Supabase n'est pas configuré)
# ============================================================================
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# E-mail administrateur principal (optionnel)
ADMIN_EMAIL=""

# URL publique de l'application
APP_URL="http://localhost:3000"

# Optionnel : clé Gemini API si des fonctionnalités IA sont activées
GEMINI_API_KEY="MY_GEMINI_API_KEY"
